# Cache for frozen projects data (matches root netlify.toml)
/data/projects.json
  Cache-Control: public, max-age=3600

# Legacy API path cache headers (no app routes today; kept for parity with netlify.toml)
/api/*
  Cache-Control: public, max-age=300

# Vite build assets (matches projects-frontend-react/netlify.toml)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
