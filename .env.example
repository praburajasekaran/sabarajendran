# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Gemini Model Configuration
GEMINI_MODEL=models/gemini-2.5-flash

# PDF Processing Configuration
PDF_DIR=docs/kurinjipadi-block-projects
OUTPUT_CSV=projects_kurinjipadi_gemini.csv
BLOCK_NAME=Kurinjipadi

# Image Processing Options
PDF_DPI=300

# Rate Limiting (seconds)
RATE_LIMIT_PAGE_DELAY=1.0
RATE_LIMIT_PDF_DELAY=2.0

# Retry Configuration
MAX_RETRIES=3

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=logs
ENABLE_FILE_LOGGING=true

# Validation Options
VALIDATE_BUDGET_MIN=1000
VALIDATE_BUDGET_MAX=100000000
REQUIRE_TAMIL_TEXT=true
